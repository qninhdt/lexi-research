# Copy to .env locally; never commit credentials.
LEXI_SOURCE_DB=/absolute/path/to/lexi-ai/data

# Any OpenAI-compatible teacher endpoint. Required for the probe and dataset pilot.
LEXI_TEACHER_BASE_URL=https://provider.example/v1
LEXI_TEACHER_API_KEY=replace-me
LEXI_TEACHER_MODEL=replace-me

# Optional safety/cost controls.
# LangChain strategies: json_schema, function_calling, or json_mode.
LEXI_TEACHER_METHOD=json_mode
LEXI_TEACHER_CONCURRENCY=8
# Optional retry/accounting controls. Costs are provider prices per million tokens.
LEXI_TEACHER_MAX_RETRIES=4
LEXI_TEACHER_BASE_DELAY=0.5
LEXI_TEACHER_PROMPT_COST_PER_MTOK=0
LEXI_TEACHER_COMPLETION_COST_PER_MTOK=0

# Run tracking. With no key, `tracking.mode: online` falls back to disabled
# rather than hanging in a login flow, so this is optional everywhere.
WANDB_API_KEY=replace-me
WANDB_PROJECT=lexi-research
