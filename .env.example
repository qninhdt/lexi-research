# Tau-Research Environment Configuration
# Copy to .env locally; never commit credentials.

# OpenAI-compatible API for User Simulator / Evaluation LLM
OPENAI_API_KEY=replace-me
OPENAI_API_BASE=https://api.vilao.ai/v1
OPENAI_BASE_URL=https://api.vilao.ai/v1

# User Simulator Model configuration
TAU_USER_MODEL=grok-4.6

# Experiment tracking (Weights & Biases)
WANDB_API_KEY=replace-me
WANDB_PROJECT=tau-research

# Hugging Face Hub (optional for uploading models/datasets)
HF_TOKEN=
