# Copy to .env locally; never commit credentials.
LEXI_SOURCE_DB=/absolute/path/to/lexi-ai/data

# Any OpenAI-compatible teacher endpoint. Required for the probe and dataset pilot.
LEXI_TEACHER_BASE_URL=https://provider.example/v1
LEXI_TEACHER_API_KEY=replace-me
LEXI_TEACHER_MODEL=replace-me

# Optional safety/cost controls.
LEXI_TEACHER_METHOD=json_schema
LEXI_TEACHER_CONCURRENCY=8
