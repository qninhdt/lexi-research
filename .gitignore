# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
*.dist-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / local config
.env
.env.*
!.env.example

# Third-party benchmark clone (pinned v1.0.1, restored via scripts/setup_colab.sh).
# Vendoring a 1.1GB checkout into Git history is never worth it; the pin lives in
# setup_colab.sh and pyproject [tool.uv.sources].
third_party/

# Generated training / eval artifacts. Regenerable from scripts; only split IDs
# are tracked because they document the experiment protocol.
artifacts/data/
artifacts/models/
artifacts/evaluation/

# Experiment logging
wandb/
runs/
outputs/
checkpoints/
scratch/

# Local tool state
.codegraph/
.claude/
.gemini/
.agents/
.agent/
.repomixignore

# Split/profile artifacts are regenerable (converter manifest + profile-difficulty
# document their protocol); committing them risks shipping stale mock data.
artifacts/splits/
